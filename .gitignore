# Runtime security data
data/*.log
data/*.json
includes/error_log
**/error_log
debug.log
wp-content/debug.log

# Archives / review exports
*.zip
*.tar
*.gz

# OS/editor files
.DS_Store
.idea/

# Temporary files
*.tmp
*.swp
*.bak
*.orig

# Composer dependencies
/vendor/

# Composer local cache/artifacts
.composer-cache/

# Python (the docs/ installer is plain stdlib but generates these)
__pycache__/
*.pyc

# Environment / secrets
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*

# VS Code: ignore local settings but keep the shared workspace config and IDE stubs
.vscode/*
!.vscode/settings.json
!.vscode/stubs/
!.vscode/stubs/**
# Local docs, screenshots, writeups
_docs/
